<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Split tunneling: list launcher apps (Android 11+ package visibility). -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>

    <application
        android:name=".VlessApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${vpnAppLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VlessCardVpn">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- Tap a link in Telegram/browser → the app opens and adds it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" /><data android:scheme="vmess" /><data android:scheme="trojan" /><data android:scheme="ss" />
                <data android:scheme="hysteria2" /><data android:scheme="hy2" /><data android:scheme="vcmask" /><data android:scheme="vcnet" />
                <data android:scheme="vcbackup" />
            </intent-filter>
            <!-- «Поделиться» → VLESS Card: a text with links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Launcher entries: only one is enabled at a time (Настройки → Скрытность → Иконка). -->
        <activity-alias android:name=".LauncherDefault" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherCalc" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@drawable/ic_disguise_calc" android:roundIcon="@drawable/ic_disguise_calc" android:label="Калькулятор">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNotes" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@drawable/ic_disguise_notes" android:roundIcon="@drawable/ic_disguise_notes" android:label="Заметки">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherWeather" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@drawable/ic_disguise_weather" android:roundIcon="@drawable/ic_disguise_weather" android:label="Погода">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <service
            android:name=".vpn.TunnelService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="VPN tunnel: Xray-core proxy routing" />
        </service>
        <service
            android:name=".vpn.ToggleTileService"
            android:icon="@mipmap/ic_launcher"
            android:label="VLESS Card"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".vpn.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
