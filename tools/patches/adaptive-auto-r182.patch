+        apk = root / old_name
+        signature = run(str(bt / "apksigner"), "verify", "--min-sdk-version", "21", "--verbose", "--print-certs", str(apk))
+        verify_signature(signature)
+        run(str(bt / "zipalign"), "-c", "-p", "4", str(apk))
