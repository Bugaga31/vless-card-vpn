+        "channel": "experimental",
+        "functional_checks": {
+            "unit_tests": "not_run_by_request",
+            "lint": "not_run_by_request",
+            "emulator": "not_run_by_request",
+            "physical_device": "not_run",
+        },
+        "apks": [],
